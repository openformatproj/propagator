#%Module1.0
set current_dir [file normalize [file dirname $ModulesCurrentModulefile]]
if {[file tail $current_dir] == "modulefiles"} {
    set topdir [file dirname $current_dir]/[module-info name]
} else {
    set topdir $current_dir
}
setenv PROPAGATOR_HOME $topdir
append-path PYTHONPATH $topdir/python
if {[file exists $topdir/venv]} {
    prepend-path PATH $topdir/venv/bin
    setenv VIRTUAL_ENV $topdir/venv
    set site_packages [lindex [glob -nocomplain $topdir/venv/lib/python*/site-packages] 0]
    if {$site_packages != ""} {
        append-path PYTHONPATH $site_packages
    }
}
